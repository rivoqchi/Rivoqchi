NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=1

DATABASE_URL="file:./dev.db"

JWT_ACCESS_SECRET=dev-access-secret-key-min-32-chars-long
JWT_REFRESH_SECRET=dev-refresh-secret-key-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001,http://localhost:5173

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=dev@example.com

COOKIE_SECRET=dev-cookie-secret-key-min-32-chars
