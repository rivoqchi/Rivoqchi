NODE_ENV=production
PORT=3000
API_PREFIX=api
API_VERSION=1

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/nestjs_db?schema=public

JWT_ACCESS_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_REFRESH_SECRET=CHANGE_ME_IN_PRODUCTION
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

THROTTLE_TTL=60000
THROTTLE_LIMIT=100

CORS_ORIGIN=https://yourdomain.com

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@yourdomain.com

COOKIE_SECRET=CHANGE_ME_IN_PRODUCTION
